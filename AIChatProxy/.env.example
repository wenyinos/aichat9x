# 复制为 .env 并填入你的 API Key
# Copy this file to .env and fill in your API key

AICHAT_API_KEY=sk-your-key-here
AICHAT_API_BASE=https://apihub.agnes-ai.cn/v1
AICHAT_MODEL=agnes-3.0-flash

# 单次回复的输出上限（模型上下文窗口为 256k tokens）
# Output token limit per reply (model context window is 256k tokens)
AICHAT_MAX_TOKENS=16384
AICHAT_TIMEOUT=120

# 代理监听地址与端口 / Proxy listen address and port
AICHAT_HOST=0.0.0.0
AICHAT_PORT=8080

# 默认系统提示词：让回复适配纯文本界面（不渲染 Markdown）
# Default system prompt tuned for the plain-text client (no Markdown markup)
AICHAT_SYSTEM_PROMPT="你是一个简洁准确的中文助手。直接给出结论，必要时分点说明；只输出纯文本，不要使用 Markdown 语法。"

# 客户端与代理的共享令牌（留空则关闭鉴权）/ Shared client-proxy token (leave empty to disable auth)
AICHAT_SHARED_SECRET=

# 是否在日志中记录消息全文（1=开，0=关）/ Log full message text (1=on, 0=off)
AICHAT_LOG_MESSAGES=0
